<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <conversionRule conversionWord="levelColor" class="me.ayydxn.niagara.demo.utils.NiagaraForegroundCompositeConverter"/>

    <appender name="SysOut" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%blue([%d{HH:mm:ss}]) %levelColor([%thread/%level]) %cyan(\(%logger{1}\)) %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="SysOut"/>
    </root>
</configuration>
